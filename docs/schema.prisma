// ============================================================================
// MARETRAVEL ERP - PRISMA SCHEMA DEFINITION
// Módulos: BankAccounts, Corporate Hierarchy, DebitNotes, Tickets & Expenses
// ============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------------------

enum RelationType {
  CLIENTE
  PROVEEDOR
  AMBOS
}

enum AccountCategoryType {
  EMPRESA
  PERSONA
  AEROLINEA
  HOTEL
  ONG
  INSTITUCION
  RENT_A_CAR
}

enum AccountRating {
  NORMAL
  IMPORTANTE
  VIP
  CRITICA
}

enum GeneralStatus {
  ACTIVO
  INACTIVO
}

enum BankAccountType {
  CORRIENTE
  AHORROS
  FONDO_ROTATORIO
}

enum Currency {
  BOB
  USD
}

enum PaymentTerm {
  AL_CONTADO
  CREDITO_7_DIAS
  CREDITO_15_DIAS
  CREDITO_30_DIAS
}

enum DebitNoteStatus {
  BORRADOR
  IMPAGA
  PARCIAL
  PAGADA
  ANULADA
}

enum TicketStatus {
  DISPONIBLE
  ASIGNADO
  ANULADO
  REEMBOLSADO
}

enum ServiceType {
  BOLETO_GDS
  HOTEL
  PAQUETE
  SEGURO
  TRANSFER
  PENALIDAD
}

enum ExpenseCategory {
  OPERATIVO_GENERAL
  FEE_EMISION
  PENALIDAD_AEREA
  COMISION_PASARELA
  TRASLADO
  HOTELERIA
  SERVICIO_TERCERO
  TRAMITES_VISAS
  OTROS_COSTOS
}

enum ExpenseStatus {
  REGISTRADO
  PAGADO
  ANULADO
}

// ----------------------------------------------------------------------------
// MODELS
// ----------------------------------------------------------------------------

model Account {
  id              String              @id @default(uuid())
  code            String              @unique
  name            String
  legalName       String?             @map("legal_name")
  nit             String?
  relationType    RelationType        @map("relation_type")
  accountType     AccountCategoryType @map("account_type")
  rating          AccountRating       @default(NORMAL)
  department      String?
  city            String?
  address         String?
  phone           String?
  cellphone       String?
  email           String?
  webPage         String?             @map("web_page")
  status          GeneralStatus       @default(ACTIVO)
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  // Relaciones
  contacts        CompanyContact[]
  debitNotes      DebitNote[]
  operatedTickets Ticket[]            @relation("TicketOperator")
  operatingItems  DebitNoteItem[]     @relation("OperatorItems")
  expenses        Expense[]           @relation("SupplierExpenses")

  @@index([nit])
  @@index([relationType])
  @@index([status])
  @@map("accounts")
}

model BankAccount {
  id            String          @id @default(uuid())
  bankName      String          @map("bank_name")
  accountNumber String          @map("account_number")
  accountType   BankAccountType @map("account_type")
  currency      Currency
  titularName   String          @map("titular_name")
  isActive      Boolean         @default(true) @map("is_active")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  // Relaciones
  expenses      Expense[]

  @@unique([bankName, accountNumber])
  @@index([isActive])
  @@index([currency])
  @@map("bank_accounts")
}

model CompanyContact {
  id          String    @id @default(uuid())
  companyId   String    @map("company_id")
  fullName    String    @map("full_name")
  department  String?
  roleTitle   String?   @map("role_title")
  email       String?
  phone       String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relaciones
  company     Account   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  debitNotes  DebitNote[]

  @@index([companyId])
  @@index([isActive])
  @@map("company_contacts")
}

model DebitNote {
  id              String          @id @default(uuid())
  ndNumber        BigInt          @unique @map("nd_number")
  accountId       String          @map("account_id")
  requesterId     String?         @map("requester_id")
  solicitanteText String?         @map("solicitante_text")
  passengerName   String?         @map("passenger_name")
  issueDate       DateTime        @map("issue_date") @db.Date
  dueDate         DateTime?       @map("due_date") @db.Date
  paymentTerm     PaymentTerm     @default(AL_CONTADO) @map("payment_term")
  currency        Currency
  totalAmountBob  Decimal         @default(0.00) @map("total_amount_bob") @db.Decimal(14, 2)
  totalAmountUsd  Decimal         @default(0.00) @map("total_amount_usd") @db.Decimal(14, 2)
  paidAmountBob   Decimal         @default(0.00) @map("paid_amount_bob") @db.Decimal(14, 2)
  paidAmountUsd   Decimal         @default(0.00) @map("paid_amount_usd") @db.Decimal(14, 2)
  balanceBob      Decimal         @default(0.00) @map("balance_bob") @db.Decimal(14, 2)
  balanceUsd      Decimal         @default(0.00) @map("balance_usd") @db.Decimal(14, 2)
  status          DebitNoteStatus @default(BORRADOR)
  observations    String?
  createdBy       String?         @map("created_by")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  // Relaciones
  client          Account         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  requester       CompanyContact? @relation(fields: [requesterId], references: [id], onDelete: SetNull)
  items           DebitNoteItem[]
  expenses        Expense[]

  @@index([accountId])
  @@index([requesterId])
  @@index([issueDate])
  @@index([status])
  @@map("debit_notes")
}

model Ticket {
  id               String          @id @default(uuid())
  ticketNumber     String          @unique @map("ticket_number")
  gdsSource        String          @default("AMADEUS") @map("gds_source")
  counterId        String?         @map("counter_id")
  issueDate        DateTime        @map("issue_date") @db.Date
  passengerName    String          @map("passenger_name")
  passengerDoc     String?         @map("passenger_doc")
  route            String
  airlineCode      String          @map("airline_code")
  operatorId       String          @map("operator_id")
  netAmount        Decimal         @map("net_amount") @db.Decimal(14, 2)
  taxAmount        Decimal         @default(0.00) @map("tax_amount") @db.Decimal(14, 2)
  totalAmount      Decimal         @map("total_amount") @db.Decimal(14, 2)
  currency         Currency
  commissionRate   Decimal         @default(0.00) @map("commission_rate") @db.Decimal(6, 2)
  commissionAmount Decimal         @default(0.00) @map("commission_amount") @db.Decimal(14, 2)
  feeAmount        Decimal         @default(0.00) @map("fee_amount") @db.Decimal(14, 2)
  status           TicketStatus    @default(DISPONIBLE)
  createdAt        DateTime        @default(now()) @map("created_at")

  // Relaciones
  operator         Account         @relation("TicketOperator", fields: [operatorId], references: [id], onDelete: Restrict)
  items            DebitNoteItem[]
  expenses         Expense[]

  @@index([ticketNumber])
  @@index([operatorId])
  @@index([status])
  @@map("tickets")
}

model DebitNoteItem {
  id                     String      @id @default(uuid())
  debitNoteId            String      @map("debit_note_id")
  serviceType            ServiceType @map("service_type")
  ticketId               String?     @map("ticket_id")
  ticketNumber           String?     @map("ticket_number")
  passengerName          String      @map("passenger_name")
  passengerDocId         String?     @map("passenger_doc_id")
  operatorId             String?     @map("operator_id")
  description            String
  currency               Currency
  totalAmount            Decimal     @map("total_amount") @db.Decimal(14, 2)
  feeAmount              Decimal     @default(0.00) @map("fee_amount") @db.Decimal(14, 2)
  providerCommissionRate Decimal     @default(0.00) @map("provider_commission_rate") @db.Decimal(6, 2)
  providerCommissionAmount Decimal   @default(0.00) @map("provider_commission_amount") @db.Decimal(14, 2)
  clientCommissionRate   Decimal     @default(0.00) @map("client_commission_rate") @db.Decimal(6, 2)
  clientCommissionAmount Decimal     @default(0.00) @map("client_commission_amount") @db.Decimal(14, 2)
  netCostToProvider      Decimal     @map("net_cost_to_provider") @db.Decimal(14, 2)
  createdAt              DateTime    @default(now()) @map("created_at")

  // Relaciones
  debitNote              DebitNote   @relation(fields: [debitNoteId], references: [id], onDelete: Cascade)
  ticket                 Ticket?     @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  operator               Account?    @relation("OperatorItems", fields: [operatorId], references: [id], onDelete: Restrict)

  @@index([debitNoteId])
  @@index([ticketId])
  @@map("debit_note_items")
}

model Expense {
  id                 String          @id @default(uuid())
  category           ExpenseCategory
  description        String
  amount             Decimal         @db.Decimal(14, 2)
  currency           Currency
  exchangeRate       Decimal         @default(6.9600) @map("exchange_rate") @db.Decimal(10, 4)
  ticketId           String?         @map("ticket_id")
  debitNoteId        String?         @map("debit_note_id")
  supplierAccountId  String?         @map("supplier_account_id")
  bankAccountId      String?         @map("bank_account_id")
  receiptVoucher     String?         @map("receipt_voucher")
  expenseDate        DateTime        @map("expense_date") @db.Date
  createdBy          String          @map("created_by")
  status             ExpenseStatus   @default(REGISTRADO)
  observations       String?
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  // Relaciones
  ticket             Ticket?         @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  debitNote          DebitNote?      @relation(fields: [debitNoteId], references: [id], onDelete: SetNull)
  supplier           Account?        @relation("SupplierExpenses", fields: [supplierAccountId], references: [id], onDelete: SetNull)
  bankAccount        BankAccount?    @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([ticketId])
  @@index([debitNoteId])
  @@index([expenseDate])
  @@index([status])
  @@map("expenses")
}
