# MARETRAVEL ERP - Variables de Entorno Opcionales
# Si no defines estas variables, el sistema opera con SQLite local nativo (data/maretravel.sqlite).
# Para persistencia en la nube (Render / Producción), utiliza tu base de datos Turso (libSQL):

TURSO_DATABASE_URL=libsql://maretravel-db-tuusuario.turso.io
TURSO_AUTH_TOKEN=tu_token_aqui
